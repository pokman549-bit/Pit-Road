# =============================================
#  PIT ROAD — Configuration
# =============================================
#
#  STEP 1: Copy this file and rename the copy to just:  .env
#  STEP 2: Paste your Anthropic API key below (between the quotes)
#  STEP 3: Save the file
#
# Your API key looks like:  sk-ant-api03-...
# Get one at: https://console.anthropic.com
#
# =============================================

ANTHROPIC_API_KEY=your_api_key_here

# Port the app runs on (3000 is fine, change if it's taken)
PORT=3000
